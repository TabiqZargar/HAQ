# Copy this file to .env if you want local AI answers. .env is git-ignored.
# Everything here stays on your machine; no API key is used or needed.

# Local Ollama endpoint. Must be a loopback address in this build.
HAQ_OLLAMA_URL=http://localhost:11434

# Exact tag of the locally installed model, as shown by `ollama list`.
# Leave empty to keep the app in retrieval-only mode. Do not guess a tag.
HAQ_OLLAMA_MODEL=

# Optional request timeout in seconds (5-300). Local models can be slow; default 120.
HAQ_OLLAMA_TIMEOUT=120
